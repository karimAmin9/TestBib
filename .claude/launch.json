{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "backend/Bib.Api"],
      "port": 5219
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
