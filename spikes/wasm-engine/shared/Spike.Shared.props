<Project>
  <!-- The real conversion engine (backend/Bib.Conversion) + a blank-page renderer and the spike runner. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\..\backend\Bib.Conversion\Bib.Conversion.csproj" />
    <Compile Include="$(MSBuildThisFileDirectory)*.cs" LinkBase="Shared" />
  </ItemGroup>
</Project>
